# Vektralogos — приклад змінних оточення. Скопіюй у .env і заповни.

# Claude API
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify (Фаза пізніше)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Друкарський профіль (абсолютний шлях до ICC, напр. FOGRA39 / SWOP).
# Завантажити ISO Coated v2 (FOGRA39): `make fetch-icc`, потім вписати шлях:
# PRINT_ICC_PROFILE=/…/project_vektralogos/server/icc/ISOcoated_v2_eci.icc
PRINT_ICC_PROFILE=
